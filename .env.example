# Required: A secret string only you know - everyone must enter this to access the app
INVITE_CODE=your-secret-invite-code-here

# Required: Random secret string for encrypting sessions (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace-this-with-a-long-random-string

# Optional (default: 3000)
PORT=3000

# Set automatically by Render
NODE_ENV=production
